def EggeMansour.Combinatorics.DefinitionBasedSymmetry : Prop :=
∀ (k : ℕ) (ρ : Equiv.Perm (Fin (k + 1))) (blocks : Fin (k + 1) → EggeMansour.Combinatorics.Pattern),
  (∀ (i : Fin (k + 1)), EggeMansour.Combinatorics.IndecomposablePattern (blocks i)) →
    EggeMansour.Combinatorics.patternSeries (EggeMansour.Combinatorics.sumPatterns (List.ofFn blocks)) =
      EggeMansour.Combinatorics.patternSeries (EggeMansour.Combinatorics.sumPatterns (List.ofFn (blocks ∘ ⇑ρ)))
theorem EggeMansour.Combinatorics.definitionBasedSymmetry_of_weightedRecurrence : ∀
  (blockH : EggeMansour.Combinatorics.Pattern → EggeMansour.Series),
  (∀ (k : ℕ) (blocks : Fin (k + 1) → EggeMansour.Combinatorics.Pattern),
      (∀ (i : Fin (k + 1)), EggeMansour.Combinatorics.IndecomposablePattern (blocks i)) →
        EggeMansour.WeightedRecurrence (k + 1) EggeMansour.seriesX EggeMansour.seriesQ
          (fun i => EggeMansour.Combinatorics.patternSeries (EggeMansour.Combinatorics.blockAt blocks i))
          (fun i => blockH (EggeMansour.Combinatorics.blockAt blocks i))
          (fun i => (EggeMansour.Combinatorics.blockAt blocks i).fst == 1)
          (EggeMansour.Combinatorics.intervalSeries blocks)) →
    EggeMansour.Combinatorics.DefinitionBasedSymmetry :=
fun blockH hRec k ρ blocks hblocks =>
  have hF := hRec k blocks hblocks;
  have hG := hRec k (blocks ∘ ⇑ρ) fun i => hblocks (ρ i);
  have hc := EggeMansour.Combinatorics.blockParameter_reorder ρ blocks EggeMansour.Combinatorics.patternSeries;
  have hh := EggeMansour.Combinatorics.blockParameter_reorder ρ blocks blockH;
  have hs := EggeMansour.Combinatorics.blockParameter_reorder ρ blocks fun p => p.fst == 1;
  have h :=
    EggeMansour.weighted_recurrence_symmetry k ρ
      (fun i => EggeMansour.Combinatorics.patternSeries (EggeMansour.Combinatorics.blockAt blocks i))
      (fun i => blockH (EggeMansour.Combinatorics.blockAt blocks i))
      (fun i => (EggeMansour.Combinatorics.blockAt blocks i).fst == 1) (EggeMansour.Combinatorics.intervalSeries blocks)
      (EggeMansour.Combinatorics.intervalSeries (blocks ∘ ⇑ρ)) hF
      (Eq.mp
        (congrArg
          (fun _a =>
            EggeMansour.WeightedRecurrence (k + 1) EggeMansour.seriesX EggeMansour.seriesQ
              (EggeMansour.permuteParams ρ fun i =>
                EggeMansour.Combinatorics.patternSeries (EggeMansour.Combinatorics.blockAt blocks i))
              (EggeMansour.permuteParams ρ fun i => blockH (EggeMansour.Combinatorics.blockAt blocks i)) _a
              (EggeMansour.Combinatorics.intervalSeries (blocks ∘ ⇑ρ)))
          hs)
        (Eq.mp
          (congrArg
            (fun _a =>
              EggeMansour.WeightedRecurrence (k + 1) EggeMansour.seriesX EggeMansour.seriesQ
                (EggeMansour.permuteParams ρ fun i =>
                  EggeMansour.Combinatorics.patternSeries (EggeMansour.Combinatorics.blockAt blocks i))
                _a (fun i => (EggeMansour.Combinatorics.blockAt (blocks ∘ ⇑ρ) i).fst == 1)
                (EggeMansour.Combinatorics.intervalSeries (blocks ∘ ⇑ρ)))
            hh)
          (Eq.mp
            (congrArg
              (fun _a =>
                EggeMansour.WeightedRecurrence (k + 1) EggeMansour.seriesX EggeMansour.seriesQ _a
                  (fun i => blockH (EggeMansour.Combinatorics.blockAt (blocks ∘ ⇑ρ) i))
                  (fun i => (EggeMansour.Combinatorics.blockAt (blocks ∘ ⇑ρ) i).fst == 1)
                  (EggeMansour.Combinatorics.intervalSeries (blocks ∘ ⇑ρ)))
              hc)
            hG)));
  Eq.mp
    (congr (congrArg Eq (EggeMansour.Combinatorics.intervalSeries_full k blocks))
      (EggeMansour.Combinatorics.intervalSeries_full k (blocks ∘ ⇑ρ)))
    h
