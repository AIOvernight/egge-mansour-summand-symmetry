EggeMansour.Combinatorics.definitionBasedSymmetry : EggeMansour.Combinatorics.DefinitionBasedSymmetry
EggeMansour.Combinatorics.reducedWeightedRecurrence {r : ℕ} (blocks : Fin r → EggeMansour.Combinatorics.Pattern)
  (hblocks : ∀ (i : Fin r), EggeMansour.Combinatorics.IndecomposablePattern (blocks i)) :
  EggeMansour.WeightedRecurrence r EggeMansour.seriesX EggeMansour.seriesQ
    (fun i => EggeMansour.Combinatorics.patternSeries (EggeMansour.Combinatorics.blockAt blocks i))
    (fun i =>
      EggeMansour.Combinatorics.patternSeries
        (EggeMansour.Combinatorics.reduce (EggeMansour.Combinatorics.blockAt blocks i)))
    (fun i => (EggeMansour.Combinatorics.blockAt blocks i).fst == 1) (EggeMansour.Combinatorics.intervalSeries blocks)
EggeMansour.Combinatorics.layeredCount_reorder {r : ℕ} (ρ : Equiv.Perm (Fin r)) (lengths : Fin r → ℕ)
  (hpositive : ∀ (i : Fin r), 0 < lengths i) (n t : ℕ) :
  EggeMansour.Combinatorics.avoiderCount (EggeMansour.Combinatorics.layeredPattern lengths).snd n t =
    EggeMansour.Combinatorics.avoiderCount (EggeMansour.Combinatorics.layeredPattern (lengths ∘ ⇑ρ)).snd n t
